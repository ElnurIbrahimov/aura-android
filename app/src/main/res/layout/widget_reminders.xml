<?xml version="1.0" encoding="utf-8"?>
<!--
  Text here is widget_text_on_dark, not widget_text_primary.

  This layout paints on widget_bg (#0A0A0B) while widget_text_primary is
  #1A1A1A — the colour for the *light* surface widget_ask_aura uses. The
  contrast ratio was about 1.1:1, so the title and every reminder message were
  invisible on a black background.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upcoming reminders"
        android:textColor="@color/widget_text_on_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/reminder_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="@color/widget_row_bg"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/reminder_msg_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_on_dark"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/reminder_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reminder_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="@color/widget_row_bg"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/reminder_msg_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_on_dark"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/reminder_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reminder_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="@color/widget_row_bg"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/reminder_msg_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_on_dark"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/reminder_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add reminder"
        android:textColor="@color/widget_accent"
        android:textSize="13sp"
        android:padding="8dp"
        android:gravity="center" />

</LinearLayout>