<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration for AuraAccessibilityService.

  What is ABSENT here matters as much as what is present:

  - flagRequestFilterKeyEvents is deliberately omitted. It would deliver every
    keystroke in every app, including passwords typed into other apps, and buys
    nothing — key interception is never needed to read or tap a screen. Some
    OEMs also gate it behind an extra prompt.
  - flagIncludeNotImportantViews is omitted. It roughly doubles the node count
    for marginal recall, and the element budget is the binding constraint on
    what reaches the model.
  - android:packageNames is omitted so scoping can be enforced in code, where
    a denylist can change at runtime and cover Aura's own package. A static
    manifest allowlist cannot be updated without a release.

  UiTraversalTest asserts the absent flags stay absent.

  canTakeScreenshot was also absent, and that one was a bug rather than a
  decision. AuraAccessibilityService.takeScreenshot() has always called the
  platform API; without the capability the system answered every call with
  onFailure, which resumed null, which CaptureScreenTool read as "nothing
  here" and fell back to MediaProjection. So the quiet screenshot path that
  README and architecture.md both describe had never once run, on any
  device, and the loud path — consent dialog, recording indicator — was the
  only one that ever worked.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_service_description"
    android:notificationTimeout="100"
    android:summary="@string/a11y_service_summary" />
