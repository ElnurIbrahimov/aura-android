# Gradle
.gradle/
**/.gradle/

# Build outputs (anywhere in the tree)
build/
**/build/

# IntelliJ / Android Studio
.idea/
**/.idea/
*.iml
**/*.iml

# OS
.DS_Store
Thumbs.db

# Android Studio captures
captures/
**/captures/

# Native build
.externalNativeBuild/
.cxx/
**/.externalNativeBuild/
**/.cxx/

# Build artifacts
# APKs are NOT tracked in git — they bloat history (~36MB each). Distribute
# via GitHub Releases. Only the current release APK is kept in-repo as a
# convenience; bump this pin when you cut a new release.
*.apk
*.aab
*.aar

# Runtime data (NOT the com.aura.data source package)
# The previous "data/" rule was a generic catch-all that wrongly ignored
# any directory named "data" at any depth — including the
# aura-core/src/main/kotlin/com/aura/data source package. New test
# files added under that package were silently dropped from commits.
# Use a more specific rule:
# Kotlin
.kotlin/
.kotlin_metadata/
**/.kotlin/
**/.kotlin_metadata/

# Local config
local.properties
**/local.properties

# Keystore
*.jks
*.keystore

# Gate B experiment vectors — derived from corpus.jsonl by scripts/gen_eval_vectors.py.
# Not committed: megabytes of floats, and a stale one silently measures the wrong model.
aura-core/src/test/resources/retrieval-eval/vectors-*.jsonl

__pycache__/
